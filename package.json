{
	"name": "auto-agents",
	"version": "0.1.0",
	"description": "Standalone multi-agent orchestration with LangGraph executors and pluggable adapters",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md", "LICENSE"],
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"boundary-check": "node scripts/boundary-check.mjs",
		"ci:check": "npm run boundary-check && npm run typecheck && npm run test && npm run build",
		"prepublishOnly": "npm run ci:check"
	},
	"peerDependencies": {
		"@langchain/anthropic": "^1.0.0",
		"@langchain/core": "^1.0.0",
		"@langchain/langgraph": "^1.0.0",
		"zod": "^3.23.0"
	},
	"peerDependenciesMeta": {
		"@langchain/anthropic": {
			"optional": true
		}
	},
	"devDependencies": {
		"@langchain/anthropic": "^1.3.14",
		"@langchain/core": "^1.1.19",
		"@langchain/langgraph": "^1.1.3",
		"@types/node": "^22.10.0",
		"tsup": "^8.5.1",
		"typescript": "^5.7.2",
		"vitest": "^3.2.4",
		"zod": "^3.24.1"
	},
	"keywords": ["agents", "langgraph", "multi-agent", "orchestration", "llm", "runtime"],
	"repository": {
		"type": "git",
		"url": "https://github.com/OWNER/auto-agents.git"
	}
}
