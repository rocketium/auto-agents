{
	"name": "auto-agents",
	"version": "0.1.0",
	"description": "Standalone multi-agent orchestration with LangGraph executors and pluggable adapters",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=24.0.0",
		"npm": ">11.12.1"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"boundary-check": "node scripts/boundary-check.mjs",
		"ci:check": "npm run boundary-check && npm run typecheck && npm run test && npm run build",
		"prepublishOnly": "npm run ci:check",
		"check-exact-version": "node scripts/check-exact-package-versions.cjs",
		"install-lefthook": "node scripts/install-lefthook.cjs",
		"prepare": "npm run install-lefthook"
	},
	"peerDependencies": {
		"@langchain/anthropic": "1.3.25",
		"@langchain/core": "1.1.36",
		"@langchain/langgraph": "1.2.6",
		"zod": "3.25.76"
	},
	"peerDependenciesMeta": {
		"@langchain/anthropic": {
			"optional": true
		}
	},
	"devDependencies": {
		"@langchain/anthropic": "1.3.25",
		"@langchain/core": "1.1.36",
		"@langchain/langgraph": "1.2.6",
		"@types/node": "22.19.15",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "3.2.4",
		"zod": "3.25.76",
		"lefthook": "2.1.6"
	},
	"keywords": [
		"agents",
		"langgraph",
		"multi-agent",
		"orchestration",
		"llm",
		"runtime"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/OWNER/auto-agents.git"
	}
}
