{
	"name": "agent-team-orchestrator",
	"version": "0.1.0",
	"description": "Multi-agent orchestration with meta-planning, LangGraph executors, and pluggable persistence and events",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md", "LICENSE"],
	"engines": { "node": ">=20.0.0" },
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"@langchain/anthropic": "^1.0.0",
		"@langchain/core": "^1.0.0",
		"@langchain/langgraph": "^1.0.0",
		"zod": "^3.23.0"
	},
	"peerDependenciesMeta": {
		"@langchain/anthropic": { "optional": true }
	},
	"devDependencies": {
		"@langchain/anthropic": "^1.3.14",
		"@langchain/core": "^1.1.19",
		"@langchain/langgraph": "^1.1.3",
		"@types/node": "^22.10.0",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"zod": "^3.24.1"
	},
	"keywords": ["agents", "langgraph", "multi-agent", "orchestration", "llm"],
	"repository": { "type": "git", "url": "https://github.com/OWNER/agent-team-orchestrator.git" }
}
